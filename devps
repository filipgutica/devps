#!/usr/bin/env python3
"""devps: list local dev servers, show where they came from, jump to them, or stop them.

Usage:
  devps                          interactive picker (fzf)
  devps ls                       plain table
  devps jump <port|pid>          focus the terminal, editor, or agent app that started it
  devps open <port|pid>          open http://localhost:<port> in the browser
  devps kill <port|pid>... [-y]  stop the whole job (runner and children)
  devps --version
  --all                          include every TCP listener, not only dev runtimes
"""
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from dataclasses import dataclass, field

__version__ = "0.1.0"  # x-release-please-version
HOME = os.path.expanduser("~")
RUNTIMES = re.compile(r"^(node|bun|deno|python[\d.]*|ruby|php|java|go|dotnet|beam\.smp|uvicorn|gunicorn|hugo|caddy|air)$", re.I)
SHELLS = {"zsh", "bash", "sh", "fish", "dash", "tcsh", "nu", "login", "sshd", "launchd"}
AGENTS = {"claude", "codex"}
IGNORED_HOME_DIRS = ("/.vscode", "/.cursor", "/Library", "/.codex/packages")
# Only these env keys are ever read. Dev server env usually holds tokens, so never widen this to a dump.
ENV_KEYS = (
    "TERM_PROGRAM", "ITERM_SESSION_ID", "WARP_FOCUS_URL", "TMUX", "TMUX_PANE", "VSCODE_PID",
    "__CFBundleIdentifier", "CLAUDE_CODE_SESSION_ID", "CLAUDE_CODE_ENTRYPOINT",
    "CODEX_THREAD_ID", "CODEX_INTERNAL_ORIGINATOR_OVERRIDE", "T3CODE_WORKTREE_PATH",
)
APP_NAMES = {"iTerm": "iTerm2", "Visual Studio Code": "VS Code", "ChatGPT": "Codex app", "stable": "Warp"}
BUNDLE_NAMES = {
    "dev.warp.Warp-Stable": "Warp", "com.googlecode.iterm2": "iTerm2", "com.apple.Terminal": "Terminal",
    "com.microsoft.VSCode": "VS Code", "com.openai.codex": "Codex app",
    "com.anthropic.claudefordesktop": "Claude app", "com.filipgutica.t3code.workbench": "T3 Code Workbench",
}

C = sys.stdout.isatty() or os.environ.get("DEVPS_COLOR") == "1"
def color(code, s): return f"\033[{code}m{s}\033[0m" if C else s
bold = lambda s: color("1", s)
dim = lambda s: color("2", s)
green = lambda s: color("32", s)
yellow = lambda s: color("33", s)
cyan = lambda s: color("36", s)
ANSI = re.compile(r"\033\[[0-9;]*m")


def run(cmd):
    r = subprocess.run(cmd, capture_output=True, text=True)
    # lsof and ps exit 1 with no stderr when nothing matches; anything else is a real failure.
    if r.returncode != 0 and r.stderr.strip():
        sys.exit(f"devps: {cmd[0]} failed: {r.stderr.strip()}")
    return r.stdout


@dataclass
class Proc:
    pid: int
    ppid: int
    tty: str
    etime: str
    comm: str

    @property
    def name(self):
        return os.path.basename(self.comm).lstrip("-")

    @property
    def app(self):
        # Outermost installed .app bundle, so "Code Helper (Plugin).app" inside VS Code still reports VS Code.
        # Anchored to app folders because Homebrew Python runs from .../Python.app and is not a GUI app.
        m = re.match(r"(?:/System)?(?:/Users/[^/]+)?/Applications/([^/]+)\.app/", self.comm)
        return m.group(1) if m else None


@dataclass
class Job:
    root: int
    ports: set = field(default_factory=set)
    listeners: dict = field(default_factory=dict)  # pid -> ports
    cwd: str = ""
    args: str = ""
    env: dict = field(default_factory=dict)
    chain: list = field(default_factory=list)  # ancestors of root, nearest first
    orphan: bool = False
    origin: str = ""
    jump: tuple = ()  # (description, [commands], clipboard or None)


def proc_table():
    table = {}
    for line in run(["ps", "-axo", "pid=,ppid=,tty=,etime=,comm="]).splitlines():
        parts = line.split(None, 4)
        if len(parts) == 5:
            pid, ppid, tty, etime, comm = parts
            table[int(pid)] = Proc(int(pid), int(ppid), tty, etime, comm)
    return table


def ancestors(pid, table):
    out, cur = [], table.get(pid)
    while cur and cur.ppid in table and cur.ppid != cur.pid:
        cur = table[cur.ppid]
        out.append(cur)
    return out


def is_boundary(p):
    return p.pid <= 1 or p.name in SHELLS or p.name in AGENTS or p.name == "tmux" or p.app is not None


def job_root(pid, table):
    """Topmost ancestor below the shell, agent, or app that launched it (the pnpm/turbo runner)."""
    cur = table[pid]
    while cur.ppid in table and not is_boundary(table[cur.ppid]):
        cur = table[cur.ppid]
    return cur.pid


def is_dev(p):
    if p.app:
        return False
    if RUNTIMES.match(p.name):
        return True
    return p.comm.startswith(HOME) and not any(p.comm.startswith(HOME + d) for d in IGNORED_HOME_DIRS)


def listening_ports():
    out, pid = {}, None
    for line in run(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN", "-Fpn"]).splitlines():
        if line.startswith("p"):
            pid = int(line[1:])
        elif line.startswith("n") and pid:
            out.setdefault(pid, set()).add(int(line.rsplit(":", 1)[1]))
    return out


def cwds(pids):
    out, pid = {}, None
    for line in run(["lsof", "-a", "-d", "cwd", "-p", ",".join(map(str, pids)), "-Fpn"]).splitlines():
        if line.startswith("p"):
            pid = int(line[1:])
        elif line.startswith("n") and pid:
            out[pid] = line[1:]
    return out


def args_of(pids):
    out = {}
    for line in run(["ps", "-ww", "-o", "pid=,args=", "-p", ",".join(map(str, pids))]).splitlines():
        pid, _, args = line.strip().partition(" ")
        out[int(pid)] = args.strip()
    return out


def envs_of(pids):
    out = {}
    for line in run(["ps", "-wwE", "-o", "pid=,command=", "-p", ",".join(map(str, pids))]).splitlines():
        pid, _, rest = line.strip().partition(" ")
        env = {}
        for key in ENV_KEYS:
            m = re.search(r"(?:^|\s)" + re.escape(key) + r"=(\S*)", rest)
            if m:
                env[key] = m.group(1)
        out[int(pid)] = env
    return out


def git(cwd, *args):
    r = subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def tilde(path):
    return "~" + path[len(HOME):] if path.startswith(HOME) else path


def project_label(cwd):
    top = git(cwd, "rev-parse", "--show-toplevel") if os.path.isdir(cwd) else ""
    if not top:
        return tilde(cwd)
    common = git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir")
    repo = os.path.basename(os.path.dirname(common)) if common.endswith("/.git") else os.path.basename(top)
    worktree = os.path.basename(top)
    sub = os.path.relpath(cwd, top)
    label = repo
    if worktree != repo:
        label += f" [{worktree}]"
    if sub != ".":
        label += f" {sub}"
    return label


def short_cmd(args):
    toks = []
    for t in args.split():
        if "/" in t and not t.startswith("-"):
            t = os.path.basename(t)
        toks.append(re.sub(r"\.[cm]?js$", "", t))
    if len(toks) > 1 and RUNTIMES.match(toks[0]):
        toks = toks[1:]
        while len(toks) > 1 and toks[0].startswith("-"):
            toks = toks[1:]
    return " ".join(toks)


def age(etime):
    days, _, rest = etime.rpartition("-")
    parts = [int(x) for x in rest.split(":")]
    h, m = (parts[0], parts[1]) if len(parts) == 3 else (0, parts[0])
    if days:
        return f"{int(days)}d"
    return f"{h}h" if h else f"{m}m"


def osa(script):
    return ["osascript", "-e", script]


def classify(job, table):
    """Set job.origin and job.jump from the live process chain, falling back to inherited env for orphans."""
    env, chain = job.env, job.chain
    app_proc = next((p for p in chain if p.app), None)
    agent = next((p for p in chain if p.name in AGENTS), None)
    tty = next((p.tty for p in chain if p.tty != "??"), None) or (table[job.root].tty if table[job.root].tty != "??" else None)
    tmux = any(p.name == "tmux" for p in chain)

    host = APP_NAMES.get(app_proc.app, app_proc.app) if app_proc else None
    if not host and job.orphan:
        host = BUNDLE_NAMES.get(env.get("__CFBundleIdentifier", ""))

    agent_label, session_hint = None, None
    if agent and agent.name == "claude":
        agent_label = "Claude Code"
        session_hint = env.get("CLAUDE_CODE_SESSION_ID")
    elif agent and agent.name == "codex":
        if "vscode" in env.get("CODEX_INTERNAL_ORIGINATOR_OVERRIDE", ""):
            agent_label = "Codex (VS Code ext)"
        else:
            agent_label = "Codex CLI" if agent.tty != "??" else "Codex app"
        session_hint = env.get("CODEX_THREAD_ID")
    elif job.orphan and env.get("CODEX_THREAD_ID"):
        agent_label, session_hint = "Codex thread", env["CODEX_THREAD_ID"]
    elif job.orphan and env.get("CLAUDE_CODE_SESSION_ID"):
        agent_label, session_hint = "Claude Code session", env["CLAUDE_CODE_SESSION_ID"]

    parts = []
    if agent_label:
        parts.append(agent_label + (f" {session_hint[:8]}" if session_hint else ""))
    if host and host != agent_label:
        parts.append(host if agent_label or not tty else f"{host} terminal {tty}")
    if tmux:
        parts.append("tmux")
    if not parts:
        parts.append(f"terminal {tty}" if tty else "unknown")
    origin = " · ".join(parts)
    if job.orphan:
        origin = f"orphaned, was {origin}" if parts != ["unknown"] else "orphaned, origin gone"
    job.origin = origin

    # Jump plan: most specific target first.
    clip = None
    if session_hint and (job.orphan or agent_label in ("Codex app", "Codex thread")):
        clip = f"codex resume {session_hint}" if "Codex" in (agent_label or "") else f"claude --resume {session_hint}"
    top = git(job.cwd, "rev-parse", "--show-toplevel") if os.path.isdir(job.cwd) else ""
    # Codex app threads inherit env from wherever the app-server daemon started (often Warp), so env host is wrong here.
    if agent_label in ("Codex app", "Codex thread"):
        job.jump = ("focus Codex app" + (" (thread may be gone)" if job.orphan else ""),
                    [["open", "-b", "com.openai.codex"]], clip)
    elif job.orphan and not host:
        job.jump = ("origin is gone, nothing to focus", [], clip)
    elif env.get("TMUX_PANE") and tmux:
        job.jump = (f"tmux pane {env['TMUX_PANE']}", [["tmux", "switch-client", "-t", env["TMUX_PANE"]]], clip)
    elif host == "Warp" and env.get("WARP_FOCUS_URL"):
        job.jump = ("Warp tab (exact)", [["open", env["WARP_FOCUS_URL"]]], clip)
    elif host == "iTerm2" and env.get("ITERM_SESSION_ID"):
        uid = env["ITERM_SESSION_ID"].split(":")[-1]
        job.jump = ("iTerm2 tab (exact)", [osa(
            'tell application "iTerm2"\nactivate\nrepeat with w in windows\nrepeat with t in tabs of w\n'
            'repeat with s in sessions of t\nif unique id of s is "' + uid + '" then\nselect w\ntell t to select\n'
            'tell s to select\nreturn\nend if\nend repeat\nend repeat\nend repeat\nend tell')], clip)
    elif host == "Terminal" and tty:
        job.jump = ("Terminal tab (exact)", [osa(
            'tell application "Terminal"\nactivate\nrepeat with w in windows\nrepeat with t in tabs of w\n'
            'if tty of t is "/dev/' + tty + '" then\nset selected of t to true\nset index of w to 1\nreturn\n'
            'end if\nend repeat\nend repeat\nend tell')], clip)
    elif host == "VS Code":
        job.jump = ("VS Code window for this folder (not the terminal tab)",
                    [["open", "-b", "com.microsoft.VSCode", top or job.cwd]], clip)
    elif app_proc:
        job.jump = (f"focus {host}", [["open", "-a", app_proc.app]], clip)
    elif env.get("__CFBundleIdentifier"):
        job.jump = (f"focus {host or env['__CFBundleIdentifier']}", [["open", "-b", env["__CFBundleIdentifier"]]], clip)
    else:
        job.jump = ("no known target", [], clip)


def collect(show_all=False):
    table = proc_table()
    jobs = {}
    for pid, ports in listening_ports().items():
        p = table.get(pid)
        if not p or (not show_all and not is_dev(p)):
            continue
        root = job_root(pid, table)
        job = jobs.setdefault(root, Job(root))
        job.ports |= ports
        job.listeners[pid] = sorted(ports)
    if not jobs:
        return [], table
    roots = list(jobs)
    cwd_map = cwds(roots + [l for j in jobs.values() for l in j.listeners])
    arg_map = args_of(roots + [l for j in jobs.values() for l in j.listeners])
    env_map = envs_of(roots)
    for job in jobs.values():
        first_listener = min(job.listeners)
        job.cwd = cwd_map.get(first_listener) or cwd_map.get(job.root, "")
        job.args = arg_map.get(job.root, table[job.root].comm)
        job.env = env_map.get(job.root, {})
        job.chain = ancestors(job.root, table)
        job.orphan = table[job.root].ppid == 1 and not table[job.root].app
        job.listener_args = {l: arg_map.get(l, "") for l in job.listeners}
        classify(job, table)
    return sorted(jobs.values(), key=lambda j: min(j.ports)), table


def rows(jobs, table):
    header = ["PORTS", "PROJECT", "COMMAND", "ORIGIN", "AGE", "PID"]
    body = []
    for j in jobs:
        body.append([
            " ".join(f":{p}" for p in sorted(j.ports)),
            project_label(j.cwd)[:55],
            short_cmd(j.args)[:32],
            j.origin[:60],
            age(table[j.root].etime),
            str(j.root),
        ])
    widths = [max(len(r[i]) for r in [header] + body) for i in range(len(header))]
    def fmt(r, is_header=False, orphan=False):
        cells = [r[i].ljust(widths[i]) for i in range(len(r))]
        if is_header:
            return dim("  ".join(cells))
        cells[0] = bold(green(cells[0]))
        cells[1] = cyan(cells[1])
        cells[3] = yellow("⚠ " + cells[3]) if orphan else cells[3]
        cells[4] = dim(cells[4])
        cells[5] = dim(cells[5])
        return "  ".join(cells)
    return fmt(header, True), [fmt(r, orphan=j.orphan) for r, j in zip(body, jobs)]


def find(jobs, sel):
    sel = sel.lstrip(":")
    if not sel.isdigit():
        return None
    n = int(sel)
    return (next((j for j in jobs if n in j.ports), None)
            or next((j for j in jobs if n == j.root or n in j.listeners), None))


def subtree(root, table):
    kids = {}
    for p in table.values():
        kids.setdefault(p.ppid, []).append(p.pid)
    out, stack = [], [root]
    while stack:
        pid = stack.pop()
        out.append(pid)
        stack.extend(kids.get(pid, []))
    return out


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def by_root(jobs, key):
    return next((j for j in jobs if key.isdigit() and j.root == int(key)), None)


def stop(job, table, yes=False):
    # Re-read processes: the picker may have been open for minutes, so children or PIDs may have changed.
    old_comm, table = table[job.root].comm, proc_table()
    if table.get(job.root) is None or table[job.root].comm != old_comm:
        print(yellow(f"Job {job.root} is gone or its PID was reused. Refresh and try again."))
        return False
    # Never signal GUI apps, pid 1, or this script's own ancestry (the terminal or agent running devps).
    protected = {os.getpid()} | {p.pid for p in ancestors(os.getpid(), table)}
    pids = [p for p in subtree(job.root, table) if p > 1 and p not in protected and not table[p].app]
    if not pids:
        print(yellow(f"Nothing safe to stop for job {job.root} (GUI app or own ancestry)."))
        return False
    print(f"Stop {bold(' '.join(f':{p}' for p in sorted(job.ports)))} {cyan(project_label(job.cwd))}")
    print(dim(f"  {len(pids)} processes: " + ", ".join(f"{p} {table[p].name}" for p in pids[:8])
              + (" …" if len(pids) > 8 else "")))
    if not yes:
        try:
            if input("  Proceed? [y/N] ").strip().lower() != "y":
                print("  Skipped.")
                return False
        except EOFError:
            return False
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except (ProcessLookupError, PermissionError):
            pass
    deadline = time.time() + 3
    while time.time() < deadline and any(alive(p) for p in pids):
        time.sleep(0.1)
    survivors = [p for p in pids if alive(p)]
    for pid in survivors:
        try:
            os.kill(pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass
    print(green("  Stopped.") + (dim(f" ({len(survivors)} needed SIGKILL)") if survivors else ""))
    return True


def jump(job):
    desc, cmds, clip = job.jump
    for cmd in cmds:
        subprocess.run(cmd, capture_output=True)
    if clip and shutil.which("pbcopy"):
        subprocess.run(["pbcopy"], input=clip, text=True)
    print(f"→ {desc}" + (f"\n  copied: {bold(clip)}" if clip else ""))


def open_browser(job):
    for port in sorted(job.ports):
        subprocess.run(["open", f"http://localhost:{port}"])


def preview(job, table):
    print(f"{bold(' '.join(f':{p}' for p in sorted(job.ports)))}  {cyan(project_label(job.cwd))}  {dim(age(table[job.root].etime) + ' old')}")
    print(f"{dim('origin')}  {yellow(job.origin) if job.orphan else job.origin}")
    print(f"{dim('jump  ')}  {job.jump[0]}" + (f"  (+ copies `{job.jump[2]}`)" if job.jump[2] else ""))
    print(f"{dim('cwd   ')}  {tilde(job.cwd)}")
    print(f"{dim('cmd   ')}  {job.args[:300]}")
    print(f"\n{dim('launched by (nearest first)')}")
    for p in job.chain[:6]:
        label = APP_NAMES.get(p.app, p.app) if p.app else p.name
        print(f"  {p.pid:>6} {label}" + (dim(f"  {p.tty}") if p.tty != "??" else ""))
    print(f"\n{dim('listeners')}")
    for pid, ports in job.listeners.items():
        print(f"  {pid:>6} {' '.join(f':{p}' for p in ports)}  {short_cmd(job.listener_args.get(pid, ''))[:80]}")
    if job.env:
        print(f"\n{dim('origin env (allowlisted keys only)')}")
        for k, v in job.env.items():
            print(f"  {k}={v}")


def ui(show_all):
    if not shutil.which("fzf") or not sys.stdin.isatty():
        return ls(show_all)
    self_cmd = f"DEVPS_COLOR=1 {sys.executable} {os.path.abspath(__file__)}" + (" --all" if show_all else "")
    while True:
        jobs, table = collect(show_all)
        if not jobs:
            print("No dev servers running.")
            return
        header, lines = rows(jobs, table)
        fzf_input = "\n".join([f"0\t{header}"] + [f"{j.root}\t{l}" for j, l in zip(jobs, lines)])
        r = subprocess.run([
            "fzf", "--ansi", "--multi", "--layout=reverse", "--height=90%", "--no-sort",
            "--delimiter=\t", "--with-nth=2..", "--header-lines=1",
            "--header=enter jump  ·  ctrl-o browser  ·  ctrl-x stop  ·  tab multi-select  ·  ctrl-r refresh",
            "--expect=enter,ctrl-o,ctrl-x",
            "--preview", f"{self_cmd} _preview {{1}}", "--preview-window=down,50%,wrap",
            "--bind", f"ctrl-r:reload({self_cmd} _lines)",
        ], input=fzf_input, stdout=subprocess.PIPE, text=True, env={**os.environ, "DEVPS_COLOR": "1"})
        out = r.stdout.splitlines()
        if r.returncode != 0 or len(out) < 2:
            return
        key, picked = out[0], [by_root(jobs, l.split("\t", 1)[0]) for l in out[1:]]
        picked = [j for j in picked if j]
        if key == "ctrl-x":
            for j in picked:
                stop(j, table)
            input(dim("press enter to go back"))
            continue
        if key == "ctrl-o":
            for j in picked:
                open_browser(j)
            return
        return jump(picked[0])


def ls(show_all):
    jobs, table = collect(show_all)
    if not jobs:
        print("No dev servers running.")
        return
    header, lines = rows(jobs, table)
    print(header)
    print("\n".join(lines))


def main(argv):
    show_all = "--all" in argv
    yes = "-y" in argv or "--yes" in argv
    argv = [a for a in argv if a not in ("--all", "-y", "--yes")]
    cmd, rest = (argv[0], argv[1:]) if argv else ("ui", [])
    if cmd in ("-V", "--version"):
        return print(__version__)
    if cmd in ("-h", "--help", "help"):
        return print(__doc__.strip())
    if cmd == "ui":
        return ui(show_all)
    if cmd == "ls":
        return ls(show_all)
    if cmd == "_lines":
        jobs, table = collect(show_all)
        header, lines = rows(jobs, table)
        return print("\n".join([f"0\t{header}"] + [f"{j.root}\t{l}" for j, l in zip(jobs, lines)]))
    if cmd in ("_preview", "jump", "open", "kill", "stop"):
        if not rest:
            sys.exit(f"devps {cmd}: give a port or pid")
        jobs, table = collect(show_all)
        for sel in rest:
            job = by_root(jobs, sel) if cmd == "_preview" else find(jobs, sel)
            if not job:
                print(f"devps: no dev server matches {sel}", file=sys.stderr)
                continue
            if cmd == "_preview":
                preview(job, table)
            elif cmd == "jump":
                jump(job)
            elif cmd == "open":
                open_browser(job)
            else:
                stop(job, table, yes)
        return
    sys.exit(f"devps: unknown command {cmd!r}. Try devps --help")


if __name__ == "__main__":
    main(sys.argv[1:])
